+
+static GstStateChangeReturn
+gst_stream_combiner_change_state (GstElement * element, GstStateChange transition)
+{
+  GstStreamCombiner *combiner = (GstStreamCombiner *) element;
+  GstStateChangeReturn ret;
+  GList *item;
+
+  ret = GST_ELEMENT_CLASS (gst_stream_combiner_parent_class)->change_state
+      (element, transition);
+  if (ret == GST_STATE_CHANGE_FAILURE)
+    return ret;
+
+  if (transition == GST_STATE_CHANGE_PAUSED_TO_READY) {
+    /* EOS belongs to one recording. Camerabin reuses encodebin via READY;
+     * stale inactive-branch EOS must not close the next encoder's tail. */
+    STREAMS_LOCK (combiner);
+    for (item = combiner->sinkpads; item; item = item->next)
+      GST_STREAM_COMBINER_PAD (item->data)->is_eos = FALSE;
+    combiner->draining_encoder = FALSE;
+    STREAMS_UNLOCK (combiner);
+  }
+  return ret;
 }
 
